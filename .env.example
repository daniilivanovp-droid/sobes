DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# Чем проверять ответы: groq, claude, ollama, openai или heuristic (без ИИ).
# Если не указано: Claude или Groq, если задан их ключ; иначе Ollama, если она запущена; иначе без ИИ.
GRADER=

# Groq (бесплатно): ключ на https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-120b"

# Claude API (платно): ключ на https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Локальная модель через Ollama (https://ollama.com): ollama pull qwen3:8b
OLLAMA_MODEL="qwen3:8b"
OLLAMA_URL="http://localhost:11434"

# Любой другой OpenAI-совместимый API (OpenRouter, Mistral и т.п.), для GRADER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Notion: синхронизация банка вопросов со страницы Notion (бесплатно).
# Ключ интеграции на https://www.notion.so/profile/integrations, затем на странице: «…» → Connections → ваша интеграция.
NOTION_TOKEN=
# Ссылка на страницу. Если пусто, ищется страница с названием «Банк вопросов».
NOTION_PAGE=
