DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
# Ключ Claude API для оценки ответов. Без него работает упрощённая оценка.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Через что оценивать ответы: claude, ollama или heuristic.
# Если не указано: Claude при наличии ключа, иначе Ollama, если она запущена и модель скачана, иначе упрощённая оценка.
GRADER=
# Локальная модель через Ollama (https://ollama.com): ollama pull qwen3:8b
OLLAMA_MODEL="qwen3:8b"
OLLAMA_URL="http://localhost:11434"
